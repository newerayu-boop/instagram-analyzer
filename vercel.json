{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/([^/.]+)", "dest": "/api/$1.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/masterclass/?", "dest": "/public/masterclass/index.html" },
    { "src": "/portfolio/?", "dest": "/public/portfolio/index.html" },
    { "src": "/leads/?", "dest": "/public/leads/index.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
