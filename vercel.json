{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/([^/.]+)", "dest": "/api/$1.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/masterclass/?", "dest": "/public/masterclass/index.html" },
    { "src": "/leads/?", "dest": "/public/leads/index.html" },
    { "src": "/dashboard/?", "dest": "/public/dashboard/index.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "crons": [
    { "path": "/api/tasks-digest?mode=morning", "schedule": "0 4 * * *" },
    { "path": "/api/tasks-digest?mode=evening", "schedule": "0 14 * * *" }
  ]
}
